SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (defaults to SQLite, uncomment for PostgreSQL)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=mayor4code
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# Google OAuth (required for "Continue with Google" button)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add redirect URI: http://localhost:8010/google/callback/ (dev) or https://yourdomain.com/google/callback/ (prod)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8010/google/callback/

# Email (console for dev, SMTP for prod)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=noreply@mayor4code.com